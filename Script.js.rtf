let completedChapters = JSON.parse(localStorage.getItem('completedChapters')) || [];\
let readingTime = parseInt(localStorage.getItem('readingTime')) || 0;\
\
function showTab(tabName) \{\
  document.querySelectorAll('.content-section').forEach(sec => sec.classList.remove('active'));\
  document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));\
\
  document.getElementById(tabName).classList.add('active');\
  event.target.classList.add('active');\
\
  if (tabName === 'progress') \{\
    updateStats();\
  \}\
  if (tabName === 'resources') \{\
    renderResources();\
  \}\
\}\
\
function updateStats() \{\
  const completed = completedChapters.length;\
  const rate = chapters.length > 0 ? Math.round((completed / chapters.length) * 100) : 0;\
  document.getElementById('progressFill').style.width = rate + '%';\
  document.getElementById('progressText').textContent = `$\{completed\} of $\{chapters.length\} chapters completed`;\
  document.getElementById('completedCount').textContent = completed;\
  document.getElementById('readingTime').textContent = readingTime;\
  document.getElementById('completionRate').textContent = rate + '%';\
\}\
\
function renderChapters() \{\
  const grid = document.getElementById('chapterGrid');\
  grid.innerHTML = '';\
  chapters.forEach(ch => \{\
    const isDone = completedChapters.includes(ch.id);\
    const card = document.createElement('div');\
    card.className = `chapter-card $\{isDone ? 'completed' : ''\}`;\
    card.onclick = () => openChapter(ch);\
\
    const tagsHtml = ch.tags.map(t => `<span class="tag">$\{t\}</span>`).join('');\
    card.innerHTML = `\
      <div class="chapter-number $\{isDone ? 'completed' : ''\}">$\{isDone ? '\uc0\u10003 ' : ch.id\}</div>\
      <div class="chapter-title">$\{ch.title\}</div>\
      <div class="chapter-icon">$\{ch.icon\}</div>\
      <div class="chapter-description">$\{ch.description\}</div>\
      <div class="chapter-tags">$\{tagsHtml\}</div>\
    `;\
    grid.appendChild(card);\
  \});\
\}\
\
function openChapter(ch) \{\
  document.getElementById('modalTitle').textContent = `Chapter $\{ch.id\}: $\{ch.title\}`;\
  document.getElementById('modalQuote').textContent = ch.quote;\
  document.getElementById('modalBody').innerHTML = ch.content + `\
    <div class="action-buttons">\
      <button class="btn btn-primary" onclick="markCompleted($\{ch.id\})">\
        $\{completedChapters.includes(ch.id) ? '\uc0\u10003  Completed' : 'Mark as Complete'\}\
      </button>\
      <button class="btn btn-secondary" onclick="closeModal()">Close</button>\
    </div>\
  `;\
  document.getElementById('chapterModal').style.display = 'block';\
  const modalContent = document.querySelector('.modal-content');\
  modalContent.scrollTop = 0;\
\
  window.chapterStartTime = Date.now();\
\}\
\
function closeModal() \{\
  document.getElementById('chapterModal').style.display = 'none';\
  if (window.chapterStartTime) \{\
    const mins = Math.round((Date.now() - window.chapterStartTime) / 60000);\
    if (mins > 0) \{\
      readingTime += mins;\
      localStorage.setItem('readingTime', readingTime.toString());\
      updateStats();\
    \}\
  \}\
\}\
\
function markCompleted(id) \{\
  if (!completedChapters.includes(id)) \{\
    completedChapters.push(id);\
    localStorage.setItem('completedChapters', JSON.stringify(completedChapters));\
    updateStats();\
    renderChapters();\
    const btn = document.querySelector('.btn-primary');\
    btn.innerHTML = '\uc0\u10003  Completed';\
    btn.style.background = 'linear-gradient(135deg, #4CAF50, #45a049)';\
  \}\
\}\
\
// Close when clicking outside modal\
window.onclick = function(evt) \{\
  const modal = document.getElementById('chapterModal');\
  if (evt.target === modal) \{\
    closeModal();\
  \}\
\}\
\
// Render initial views\
renderChapters();\
updateStats();\
\
function renderResources() \{\
  const res = document.getElementById('resources');\
  const container = document.createElement('div');\
  container.className = 'feature-grid';\
  chapters.forEach(ch => \{\
    const card = document.createElement('div');\
    card.className = 'feature-card';\
    card.innerHTML = `\
      <div class="feature-icon">$\{ch.icon\}</div>\
      <h3>$\{ch.title\}</h3>\
      <p><em>$\{ch.quote\}</em></p>\
      <p>$\{ch.description\}</p>\
      <button class="btn btn-secondary" onclick="openChapter($\{ch.id\})">View Chapter</button>\
    `;\
    container.appendChild(card);\
  \});\
\
  res.innerHTML = `\
    <h2>Chapter Summaries & Resources</h2>\
    <div class="intro-text">\
      <p>This tab gives quick access to chapter overviews and full content.</p>\
    </div>\
  `;\
  res.appendChild(container);\
\}\
}